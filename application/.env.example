# ── Application Layer environment variables ──────────────────────────
# Copy to .env and adjust as needed.

API_HOST=0.0.0.0
API_PORT=8000

# Model Layer (Part 1) LLM endpoint
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1

# Routing: "naive" (full-prompt) or "vector" (semantic retrieval)
ROUTING_MODE=vector
TOP_K_TOOLS=5

# Groq API — free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
